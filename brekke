#!/usr/bin/env bash
# brekke — wrapper de execução no host.
# Puxa a imagem brekke (Docker Hub) se ausente e dispara o container
# com ~/.brekke montado em /data.
set -euo pipefail

BREKKE_IMAGE="${BREKKE_IMAGE:-brekke-cloud/brekke-cli:latest}"
BREKKE_HOME="${BREKKE_HOME:-$HOME/.brekke}"

if ! command -v docker >/dev/null 2>&1; then
  echo "erro: docker não está instalado ou fora do PATH" >&2
  exit 1
fi

if [ ! -d "$BREKKE_HOME" ]; then
  echo "criando diretório $BREKKE_HOME" >&2
  mkdir -p "$BREKKE_HOME/profiles" "$BREKKE_HOME/backups"
fi

if ! docker image inspect "$BREKKE_IMAGE" >/dev/null 2>&1; then
  echo "puxando imagem $BREKKE_IMAGE..." >&2
  docker pull "$BREKKE_IMAGE"
fi

exec docker run --rm -i \
  --network host \
  -v "$BREKKE_HOME:/data" \
  "$BREKKE_IMAGE" \
  "$@"