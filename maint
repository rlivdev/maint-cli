#!/usr/bin/env bash
# maint — wrapper de execução no host.
# Puxa a imagem maint (Docker Hub) se ausente e dispara o container
# com ~/.maint montado em /data e o socket docker exposto.
#
# Migrate: o diretório de migrações flyway vive no host (repo do serviço).
# O wrapper resolve --migrations para caminho absoluto e o monta no mesmo
# path dentro do container, para o maint validar e o docker aninhado
# (redgate/flyway) alcançar com -v no daemon do host.
set -euo pipefail

MAINT_IMAGE="${MAINT_IMAGE:-rlivdev/maint-cli:latest}"
MAINT_HOME="${MAINT_HOME:-$HOME/.maint}"
DOCKER_SOCKET="${DOCKER_SOCKET:-/var/run/docker.sock}"

# resolve <path> para caminho absoluto (se existir). Vazio se ausente.
resolve() {
  local d="$1"
  if [ -d "$d" ]; then
    (cd "$d" && pwd)
  elif [ -e "$d" ]; then
    local base name
    base="$(dirname "$(pwd)/$d")"
    name="$(basename "$d")"
    (cd "$base" 2>/dev/null && echo "$(pwd)/$name")
  else
    echo ""
  fi
}

if ! command -v docker >/dev/null 2>&1; then
  echo "erro: docker não está instalado ou fora do PATH" >&2
  exit 1
fi

if [ ! -d "$MAINT_HOME" ]; then
  echo "criando diretório $MAINT_HOME" >&2
  mkdir -p "$MAINT_HOME/profiles" "$MAINT_HOME/backups"
fi

if ! docker image inspect "$MAINT_IMAGE" >/dev/null 2>&1; then
  echo "puxando imagem $MAINT_IMAGE..." >&2
  docker pull "$MAINT_IMAGE"
fi

MOUNTS=(-v "$MAINT_HOME:/data")
if [ -S "$DOCKER_SOCKET" ]; then
  MOUNTS+=(-v "$DOCKER_SOCKET:/var/run/docker.sock")
else
  echo "aviso: socket docker $DOCKER_SOCKET não encontrado; comando migrate não funcionará" >&2
fi

args=("$@")
for j in "${!args[@]}"; do
  a="${args[$j]}"
  case "$a" in
    --migrations=*)
      dir="${a#*=}"
      abs="$(resolve "$dir")"
      if [ -n "$abs" ]; then
        MOUNTS+=(-v "$abs:$abs")
        args[$j]="--migrations=$abs"
      fi
      ;;
    --migrations)
      if [ $((j+1)) -lt "${#args[@]}" ]; then
        dir="${args[$((j+1))]}"
        abs="$(resolve "$dir")"
        if [ -n "$abs" ]; then
          MOUNTS+=(-v "$abs:$abs")
          args[$((j+1))]="$abs"
        fi
      fi
      ;;
  esac
done

exec docker run --rm -i \
  --network host \
  "${MOUNTS[@]}" \
  "$MAINT_IMAGE" \
  "${args[@]}"